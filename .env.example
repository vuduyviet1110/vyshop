# ==========================================
# VYYY BOUTIQUE - ENVIRONMENT VARIABLES
# ==========================================

# 🏦 Thông tin tài khoản ngân hàng chính thức
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_NAME=MBBank (NHTMCP Quân Đội)
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=1230016022004
NEXT_PUBLIC_BANK_ACCOUNT_NAME=DOAN HA VY

# 🏷️ Cú pháp từ khóa nhận diện chuyển khoản mua sắm
NEXT_PUBLIC_TRANSFER_PREFIX=VYYY BOUTIQUE

# 🔒 Mã bí mật bảo mật cho SePay Webhook (API Authorization)
SEPAY_WEBHOOK_SECRET=vyyy_boutique_secret_key_2026

# 📊 Link Google Apps Script đẩy đơn hàng về Google Sheet (Nếu có)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/your_apps_script_id/exec

# 🐘 PostgreSQL Database (Supabase / Neon - Miễn phí 100%)
# Ví dụ Supabase: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Ví dụ Neon: postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/vyshop?schema=public"

# Nút chat nổi (để trống kênh nào thì ẩn kênh đó)
# Username hoặc ID của Facebook Page -> https://m.me/<giá trị>
NEXT_PUBLIC_FACEBOOK_PAGE=
# Số điện thoại Zalo hoặc ID Zalo OA -> https://zalo.me/<giá trị>
NEXT_PUBLIC_ZALO_ID=

# Thông tin hiện ở chân trang (để trống thì không hiện)
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_LEGAL=
